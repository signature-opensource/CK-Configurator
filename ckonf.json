{
  // The central configuration of the solution: one party, the configurator ("CK/$Configurator"), a web application
  // (its "#Production" deployment packages it as a desktop application).
  // The ckonf.json of its Builder is generated from its AppContext below when the Builder runs (then the appsettings.json
  // of its host): edit this file, not the projections.
  "Domain": "CK",
  // The projects of the Apps leave the whole domain out: the App "$Configurator" is Configurator.App and Configurator.Host.
  "GlobalDomainPrefix": "CK",

  "Defaults": {
    "App": {
      "Logging": { "LogLevel": { "Default": "Warning" } },
      "CK-Monitoring": {
        "GlobalDefaultFilter": "Debug",
        "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
      }
    }
  },

  // The AppContext "Configurator": its Builder is Configurator/Configurator.Builder, its single App "$Configurator".
  "AppContexts": {
    "Configurator": {
      "RootPath": "Configurator",
      "App": {
        "Local": {
          // A local port: the client application in a browser (the desktop application of "#Production" has its
          // endpoint in process, no port).
          "HttpEndpoint": { "Urls": "http://localhost:5400" },
          // Its client application (Configurator.Host/Clients/App), served at "/" (by its dev server in Development).
          "PartyClient": {
            "App": {
              "NgApp": { "RequestPath": "/", "DevServerPort": 4500 },
              "Hosting": true
            }
          }
        },
        // The development build has no worker package of its version: the workers reference the analyzer project of
        // this solution.
        "Configurator": { "AnalyzerProject": "CK.Configurator.Catalog.Worker/CK.Configurator.Catalog.Worker.csproj" }
      }
    }
  }
}
