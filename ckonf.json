{
  // The central configuration of the solution: one party, the configurator ("CK/$Configurator"), a desktop application.
  // The ckonf.json of its builder is generated from its entry below when the builder runs (then the appsettings.json of
  // its host): edit this file, not the projections.
  "Domain": "CK",
  // The App is named after its party: "Configurator" (Configurator.App, Configurator.Builder, Configurator.Host).
  "GlobalDomainPrefix": "CK",

  "Defaults": {
    "App": {
      "Logging": { "LogLevel": { "Default": "Warning" } },
      "CK-Monitoring": {
        "GlobalDefaultFilter": "Debug",
        "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
      }
    }
  },

  "Builders": {
    "Configurator/Configurator.Builder": {
      "App": {
        "Local": {
          // In process (CK.AppIdentity.HttpEndpoint.InProcess): no port is opened, the desktop window shows
          // "app://localhost/" and relays the requests of its page (CK.AppHost.Desktop). The dev server's live reload
          // doesn't work on "app://": to have it, run the host on a random local port with
          // --CK-AppIdentity:Local:HttpEndpoint:InProcess=false --CK-AppIdentity:Local:HttpEndpoint:Urls=http://127.0.0.1:0
          "HttpEndpoint": { "InProcess": true },
          // Its client application (Configurator.Host/Clients/App), served at "/", in the window of the desktop
          // application (CK.AppHost.Desktop): closing the window stops it.
          "PartyClient": {
            "App": {
              "NgApp": true,
              "Hosting": { "RequestPath": "/", "DevServerPort": 4500 },
              "DesktopWindow": { "Title": "CK Configurator" }
            }
          }
        },
        // The development build has no worker package of its version: the workers reference the analyzer project of
        // this solution.
        "Configurator": { "AnalyzerProject": "CK.Configurator.Catalog.Worker/CK.Configurator.Catalog.Worker.csproj" }
      }
    }
  }
}
