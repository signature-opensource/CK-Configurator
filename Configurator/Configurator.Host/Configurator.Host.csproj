<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A desktop application: no console window (its logs are files). -->
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Configurator.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bootstrap of the host (Program.cs) and the conventions of the host project. -->
    <PackageReference Include="CK.AppHost" Version="25.0.0-0.uc.4" />
    <ProjectReference Include="..\Configurator.App\Configurator.App.csproj" />
    <ProjectReference Include="..\Configurator.Builder\Configurator.Builder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>
